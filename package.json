{
  "name": "quick-mover",
  "version": "0.2.1",
  "private": true,
  "description": "Windows utility for safely backing up and formatting multiple SD cards",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "pnpm typecheck && electron-vite build",
    "package:win": "pnpm build && electron-builder --win nsis --x64",
    "package:win:dir": "pnpm build && electron-builder --win dir --x64",
    "dist": "pnpm package:win",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test",
    "test": "pnpm typecheck && pnpm lint && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "vue": "^3.5.20",
    "vuetify": "^3.9.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.6"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.23.0",
  "build": {
    "appId": "com.quickmover.sdmanager",
    "productName": "Quick Mover",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/platform/windows/b-box-config",
        "to": "b-box-config",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
